@article{ref2192,
  title = {Better science through art}},
  author = {Gabriel, Richard P. and Sullivan, Kevin J.}},
  year = {2010}},
  journal = {SIGPLAN Not.}},
  tipo = {Article}},
  publisher = {Association for Computing Machinery}},
  abstract = {How do artists and scientists work? The same.}},
